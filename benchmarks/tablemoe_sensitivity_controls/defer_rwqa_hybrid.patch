+def job_deferral(identifier, parent=None):
+    path = ROOT / 'job_policy.json'
+    policy = read(path) if path.exists() else {}
+    candidates = (identifier, parent or identifier.removeprefix('score_'))
+    for candidate in candidates:
+        record = policy.get('deferred_jobs', {}).get(candidate)
+        if record is not None:
+            return record
+    if any(candidate in policy.get('resumed_jobs', []) for candidate in candidates):
+        return None
+    for candidate in candidates:
+        record = STATE.get('disabled_jobs', {}).get(candidate, {})
+        if record.get('state') == 'deferred' and record.get('explicit_resume_required'):
+            return record
+    return None
+
+
+def apply_job_policy(include_running=False):
